# NamPS OS — Environment Configuration
# Copy this file to .env.local for local development or .env for production

NODE_ENV=development
PORT=3000

# PostgreSQL Connection String
# For local Docker: postgresql://namps_user:namps_password@localhost:5432/namps_os
# For Neon / Supabase: postgresql://[user]:[password]@[host]/[db]?sslmode=require
DATABASE_URL=postgresql://namps_user:namps_password@localhost:5432/namps_os

# Application Secret Key for JWT Session Tokens
JWT_SECRET=super-secret-jwt-key-replace-in-production-with-random-32-chars

# Pepper for Anonymous Suggestion Hashing
ANONYMOUS_PEPPER=random-salt-pepper-replace-in-production

# Demo Mode Enabled (true / false)
NEXT_PUBLIC_DEMO_MODE=true

# Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
